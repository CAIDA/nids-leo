# Large source recordings
/Tutorial/raw_data/*.fc32

# Outputs generated by the tutorial notebook
/Tutorial/processed_data/*
!/Tutorial/processed_data/.gitignore
/Tutorial/decoder_results/*
!/Tutorial/decoder_results/.gitignore

# Jupyter-generated files and optional exported notebooks
**/.ipynb_checkpoints/
/Tutorial/outputs/
/Tutorial/figures/
/Tutorial/executed/
/Tutorial/.raw_data_download/
/Tutorial/*-executed.ipynb
/Tutorial/*.nbconvert.ipynb
/Tutorial/*.html

# Python and native decoder build products
**/__pycache__/
*.py[cod]
/Tutorial/utils/decoder_core/build/

# Interrupted file conversions
*.partial
*.tmp
